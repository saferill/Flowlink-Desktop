<Page
    x:Class="FlowLink.Views.Onboarding.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FlowLink.Converters"
    xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:FlowLink.Helpers"
    xmlns:local="using:FlowLink.Views.Onboarding"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FlowLink.Data.Models"
    Background="{ThemeResource App.PageBackgroundBrush}"
    mc:Ignorable="d">

    <Page.Resources>
    </Page.Resources>

    <Grid
        MaxWidth="600"
        Margin="20"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <StackPanel Spacing="24">

            <!--  Title  -->
            <TextBlock
                HorizontalAlignment="Center"
                Style="{ThemeResource TitleLargeTextBlockStyle}"
                Text="{helpers:ResourceString Name=OnboardingDevice/Title}" />

            <!--  Subtitle  -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="{helpers:ResourceString Name=OnboardingDevice/Subtitle}" />

            <!--  QR Code  -->
            <Image
                x:Name="QrCodeImage"
                Width="256"
                Height="256"
                HorizontalAlignment="Center"
                Stretch="Uniform" />

            <!--  Devices List  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:DiscoveredDevice">
                        <Button
                            Width="250"
                            Height="60"
                            Padding="12,8"
                            Click="ConnectButton_Click"
                            HorizontalAlignment="Stretch"
                            Tag="{x:Bind}"
                            HorizontalContentAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}">
                            <Grid Margin="0,0,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <SymbolIcon
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Symbol="CellPhone" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Vertical"
                                    Spacing="5">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        FontSize="12"
                                        Opacity="0.7"
                                        Text="{x:Bind VerificationKey}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--  Direct Connect by IP / Tailscale  -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <TextBox x:Name="DirectIpTextBox" Width="180" PlaceholderText="100.x.x.x (Tailscale IP)" />
                <Button x:Name="DirectConnectButton" Click="DirectConnectButton_Click" Content="Hubungkan IP" />
            </StackPanel>

            <!--  Tailscale tips  -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="11"
                Opacity="0.7"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Text="* Tips: Jika menggunakan VPN Tailscale di HP &amp; PC Anda dengan akun yang sama, perangkat Android Anda akan otomatis terdeteksi di atas secara langsung tanpa perlu scan QR Code!" />

            <!--  Skip Button  -->
            <HyperlinkButton
                x:Name="SkipButton"
                HorizontalAlignment="Center"
                Click="SkipButton_Click"
                Content="{helpers:ResourceString Name=OnboardingSkip}" />
        </StackPanel>
    </Grid>
</Page>
